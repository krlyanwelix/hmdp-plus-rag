# 主链路 docker compose 的可覆盖变量
#   用法：把本文件复制成 deploy/.env，按需改端口后 `docker compose -f deploy/docker-compose.yml up -d`
#   （compose 会自动读同目录的 .env）

# 宿主机端口 —— 本机已经装了 MySQL/Redis/RocketMQ 时改成 3307/6380/9877/10912
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
NAMESRV_HOST_PORT=9876
BROKER_HOST_PORT=10911
BROKER_HA_HOST_PORT=10909
CANAL_HOST_PORT=11111
APP_HOST_PORT=8081

# MySQL root 密码（schema/data 与 app 都用这个）
MYSQL_ROOT_PASSWORD=wp123456

# 应用调用赛事助手的地址：助手跑在宿主机（8090）就用 host.docker.internal
RAG_BASE_URL=http://host.docker.internal:8090
RAG_SHARED_SECRET=yejing-rag-2026-local-dev
