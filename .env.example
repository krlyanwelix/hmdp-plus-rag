# 复制为 .env 后按需修改。所有项都有默认值，不配置也能跑。

# ---------- 生成（不配则 ask 命令退化为只展示检索结果） ----------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TEMPERATURE=0.1

# ---------- 向量化 ----------
# auto = 有 sentence-transformers 就用它，否则用内置 hashing embedder
EMBEDDER=auto
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
EMBED_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：

# ---------- 向量库 ----------
# auto = 有 chromadb 就用它，否则用内置 numpy 暴力检索
STORE_BACKEND=auto

# ---------- 切块 ----------
PARENT_SIZE=1500
CHUNK_SIZE=500
CHUNK_OVERLAP=80
MIN_CHUNK_SIZE=40

# ---------- 检索 ----------
TOP_K_RECALL=30
TOP_K_FINAL=5
USE_BM25=true
RRF_K=60

# ---------- 重排 ----------
RERANKER=auto
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---------- 评测 ----------
EVAL_K=5
