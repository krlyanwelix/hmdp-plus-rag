# 复制为 .env 后按需修改。所有项都有默认值，不配置也能跑。
# 下面是「跟着 docker compose 起来的那套」的推荐值：向量库连独立 Milvus，
# 缓存与限流走同一个 Redis。

# ---------- 语料与评测集 ----------
RAW_DIR=data/sports
EVAL_DATASET=eval/dataset-sports.jsonl

# ---------- 生成 ----------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TEMPERATURE=0.1

# ---------- 生成的三个超时 ----------
# 非流式整体超时；流式单次 socket 读超时（防"一个字节都不给"）；
# 流式整段墙钟上限（防"慢速滴灌把连接拖到天荒地老"）。
LLM_TIMEOUT=45
LLM_STREAM_TIMEOUT=20
LLM_DEADLINE=45

# ---------- 成本估算（可选） ----------
# 每百万 token 单价，配了就会在 ask 后显示估算成本；留空则只显示 token 数。
# LLM_PRICE_INPUT=1
# LLM_PRICE_OUTPUT=4

# ---------- 向量化 ----------
# auto = 有 sentence-transformers 就用它，否则退回内置 hashing embedder
# openai = 走 API embedding（不占显存、不加载本地模型）
# 注意：auto 不会自动改用 API —— 没装本地模型时它会静默退回 hashing，
# 想走 API 就必须显式写 openai。
EMBEDDER=openai
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
# BGE 系列是「非对称检索」模型，查询端不加这个前缀会明显掉召回
EMBED_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_API_KEY=

# ---------- 向量库 ----------
# auto = milvus → chroma → 内置 numpy，按可用性降级
STORE_BACKEND=milvus
# 连独立部署的 Milvus（deploy/docker-compose.yml 起的那个）
# 变量名故意不叫 MILVUS_URI：那个名字被 pymilvus 当成全局默认连接解析，
# 设成本地文件路径会直接抛 "Illegal uri"。
RAG_MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=rag_chunks
MILVUS_METRIC=COSINE

# ---------- 答案缓存（Redis） ----------
REDIS_URL=redis://127.0.0.1:6379/0
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL=300
# 含个人报名信息的答案单独用短 TTL
RAG_CACHE_USER_TTL=60
# 缓存值用 AES-GCM 加密后再进 Redis（key 由 RAG_CACHE_KEY 派生）
RAG_CACHE_ENCRYPT=true
# RAG_CACHE_KEY=换成你自己的随机串

# ---------- 应用层限流（按 userId 令牌桶） ----------
RAG_RATE_LIMIT_ENABLED=true
RAG_RATE_LIMIT_PER_MIN=20
RAG_RATE_LIMIT_BURST=5

# ---------- 服务端内部鉴权 ----------
# Java 侧用同一个值对请求体签名，服务端验签；留空则退化为本机调试模式（不校验）
RAG_SHARED_SECRET=

# ---------- 切块 ----------
PARENT_SIZE=1500
CHUNK_SIZE=500
CHUNK_OVERLAP=80
MIN_CHUNK_SIZE=40

# ---------- 检索 ----------
TOP_K_RECALL=30
TOP_K_FINAL=5
USE_BM25=true
RRF_K=60

# ---------- 重排 ----------
# auto = 有 sentence-transformers 用 cross-encoder，否则用内置词法重排
# api = 走 /rerank 接口，不占显存、不加载本地模型
RERANKER=api
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=

# ---------- 设备（本地 embedding / 重排共用） ----------
DEVICE=auto

# ---------- 评测 ----------
EVAL_K=5
